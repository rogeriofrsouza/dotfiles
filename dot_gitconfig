[core]
    autocrlf = input
    pager = delta

[interactive]
    diffFilter = delta --color-only

[include]
    path = ~/.local/share/nvim/lazy/tokyonight.nvim/extras/delta/tokyonight_moon.gitconfig

[delta]
    navigate = true
    line-numbers = true
    syntax-theme = tokyonight_moon

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

